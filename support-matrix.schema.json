{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["primary", "packageContract", "sources", "githubActions", "tuples"],
  "properties": {
    "primary": { "type": "string", "minLength": 1 },
    "packageContract": {
      "type": "object",
      "required": ["node", "npm", "mongodbDriver"]
    },
    "sources": { "type": "object" },
    "githubActions": {
      "type": "object",
      "required": ["checkout"],
      "properties": {
        "checkout": {
          "type": "object",
          "required": ["release", "revision", "runtime", "runtimeLine", "runtimeEol"]
        }
      }
    },
    "tuples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "node",
          "npm",
          "mongodbDriver",
          "mongodbServer",
          "nodeStatus",
          "nodeLine",
          "nodeEol",
          "mongodbServerEol",
          "mongodbDriverLine",
          "nodeImage",
          "mongodbImage"
        ]
      }
    }
  }
}
