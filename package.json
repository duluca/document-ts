{
  "name": "document-ts",
  "version": "7.0.0",
  "description": "A very thin TypeScript-based async MongoDB helper with optional ODM convenience features",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "style": "prettier --check \"{src,tests}/**/*.ts\"",
    "style:fix": "npm run style -- --write",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.src.json",
    "build:test": "tsc -p tests/tsconfig.test.json --noEmit",
    "audit:ci": "audit-ci --high",
    "audit:policy:test": "node scripts/test-audit-policy.mjs",
    "verify:test-image": "node scripts/verify-test-image.mjs",
    "verify:test-image:negative": "node scripts/test-test-image-policy.mjs",
    "verify:no-download-guard": "node scripts/test-no-download-network-guard.mjs",
    "test:mongodb:start": "node scripts/start-test-mongodb.mjs",
    "test:mongodb:stop": "docker compose -f compose.test.yml down",
    "support:generate": "node scripts/generate-support-docs.mjs",
    "support:check": "node scripts/generate-support-docs.mjs --check",
    "support:policy:test": "node scripts/test-support-policy.mjs",
    "support:lifecycle": "node scripts/check-support-lifecycle.mjs",
    "pretest": "npm run verify:test-image && npm run verify:test-image:negative && npm run verify:no-download-guard && npm run support:check && npm run support:policy:test",
    "prepublishOnly": "npm run test",
    "prepare": "npm run build",
    "test": "npm run build:test && jest",
    "test:debug": "npm run build:test && node --trace-warnings node_modules/.bin/jest --no-cache",
    "test:ci": "npm run build:test && jest --ci --reporters=default --reporters=jest-junit",
    "standalone": "tsc --esModuleInterop tests/standalone.ts && node tests/standalone"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duluca/DocumentTS.git"
  },
  "keywords": [
    "mongodb",
    "odm",
    "typescript",
    "async"
  ],
  "author": "Doguhan Uluca",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/duluca/DocumentTS/issues"
  },
  "homepage": "https://github.com/duluca/DocumentTS#readme",
  "peerDependencies": {
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "audit-ci": "^7.1.0",
    "bcryptjs": "^3.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "mongodb": "6.21.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
